
import numpy as np
import random

# ----------------------------------
# 1. Define Dataset
# ----------------------------------

data = np.array([
    [1, 2], [2, 1], [2, 3], [3, 2],
    [8, 8], [9, 8], [8, 9], [9, 9],
    [4, 8], [5, 9], [4, 9], [5, 8]
])

n = len(data)
k = 3

# ----------------------------------
# 2. ACO Parameters
# ----------------------------------

ants = 10
iterations = 50

alpha = 1
beta = 2
rho = 0.5
Q = 100

random.seed(42)
np.random.seed(42)

# Initialize pheromone matrix
pheromone = np.ones((n, k))

# Initialize cluster centers
indices = np.random.choice(n, k, replace=False)
centroids = data[indices].copy()


# ----------------------------------
# 3. Calculate Cluster Centers
# ----------------------------------

def calculate_centroids(labels):

    centers = []

    for cluster in range(k):

        points = data[labels == cluster]

        centers.append(points.mean(axis=0))

    return np.array(centers)


# ----------------------------------
# 4. Calculate SSE
# ----------------------------------

def calculate_sse(labels, centers):

    total = 0

    for i in range(n):

        total += np.sum(
            (data[i] - centers[labels[i]]) ** 2
        )

    return total


# ----------------------------------
# 5. Handle Empty Clusters
# ----------------------------------

def repair_empty_clusters(labels, centers):

    labels = labels.copy()

    for cluster in range(k):

        if np.sum(labels == cluster) == 0:

            counts = np.bincount(labels, minlength=k)

            # Select a point from a cluster
            # containing more than one point
            candidates = [
                i for i in range(n)
                if counts[labels[i]] > 1
            ]

            # Move the farthest point to empty cluster
            point = max(
                candidates,
                key=lambda i: np.sum(
                    (data[i] - centers[labels[i]]) ** 2
                )
            )

            labels[point] = cluster

            centers = calculate_centroids(labels)

    return labels, centers


# ----------------------------------
# 6. Construct Clustering Solution
# ----------------------------------

def construct_solution():

    labels = np.zeros(n, dtype=int)

    for i in range(n):

        distances = np.linalg.norm(
            centroids - data[i],
            axis=1
        )

        heuristic = 1 / (distances + 1e-10)

        probabilities = (
            pheromone[i] ** alpha
            * heuristic ** beta
        )

        probabilities /= probabilities.sum()

        cluster = random.choices(
            range(k),
            weights=probabilities,
            k=1
        )[0]

        labels[i] = cluster

    centers = calculate_centroids(labels)

    labels, centers = repair_empty_clusters(
        labels, centers
    )

    return labels, centers


# ----------------------------------
# 7. Ant Colony Optimization
# ----------------------------------

best_labels = None
best_centroids = None
best_sse = float("inf")

for iteration in range(iterations):

    solutions = []

    for ant in range(ants):

        labels, centers = construct_solution()

        sse = calculate_sse(labels, centers)

        solutions.append((labels, centers, sse))

        if sse < best_sse:

            best_sse = sse
            best_labels = labels.copy()
            best_centroids = centers.copy()

    # Pheromone evaporation
    pheromone *= (1 - rho)

    # Pheromone deposit
    for labels, centers, sse in solutions:

        deposit = Q / (sse + 1e-10)

        for i in range(n):

            cluster = labels[i]

            pheromone[i][cluster] += deposit

    # Update reference centroids
    centroids = best_centroids.copy()

    print(
        "Iteration:", iteration + 1,
        "| Best SSE:", round(best_sse, 2)
    )


# ----------------------------------
# 8. Display Final Clusters
# ----------------------------------

print("\n--- CLUSTERING RESULT ---")

for cluster in range(k):

    print("\nCluster", cluster + 1)

    print(data[best_labels == cluster])

print("\nFinal Centroids:")
print(best_centroids)

print("\nMinimum SSE:", round(best_sse, 2))
